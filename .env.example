SERVICEPILOT_ENVIRONMENT=development
SERVICEPILOT_LOG_LEVEL=INFO
SERVICEPILOT_HOST=0.0.0.0
SERVICEPILOT_PORT=8000
SERVICEPILOT_RELOAD=true
SERVICEPILOT_PERSISTENCE_BACKEND=memory
# Required only when Firestore cannot infer the Google Cloud project from ADC.
SERVICEPILOT_FIRESTORE_PROJECT=
SERVICEPILOT_FIRESTORE_DATABASE=(default)
# Compose-only host path used by compose.firestore.yaml:
# SERVICEPILOT_GOOGLE_CREDENTIALS_FILE=C:/absolute/path/to/adc.json
